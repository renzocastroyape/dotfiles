# Brewfile — everyday tools referenced in .zshrc
# Reference versions: GitHub Runner macOS 27 (xcode-27-arm64)
# Install with: brew bundle --file=Brewfile

brew "rbenv"   # Ruby version manager (Ruby 3.4.12)
brew "nvm"     # Node.js version manager (Node.js 24.x)
brew "mise"    # Polyglot tool/version manager
brew "uv"      # Python manager (Python 3.15, per-project venvs)
brew "gnupg"   # GPG, used to sign commits
brew "gh"      # GitHub CLI
brew "apm"     # Agent Package Manager (AI agent configuration dependencies)

cask "copilot-cli"   # GitHub Copilot CLI
